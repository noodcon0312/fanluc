{
  "name": "fanluc",
  "version": "2.4.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start:local": "tsx server.ts",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "build:tui": "esbuild src/tui/index.tsx --bundle --platform=node --format=esm --packages=external --outfile=dist/tui.js --jsx=automatic --loader:.md=text",
    "build:all": "npm run build && npm run build:cli && npm run build:tui"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "google-translate-api-x": "^10.7.3",
    "jsdom": "^30.1.0",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "^0.546.0",
    "mermaid": "^12.0.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "ink": "^7.1.1",
    "ink-text-input": "^6.0.0",
    "string-width": "^8.2.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "description": "fanluc self-hosted AI chat: monochrome terminal-style web UI, real local shell execution, parallel web/image search, MCP, memory, sub-agents",
  "bin": {
    "fanluc": "bin/fanluc.js"
  },
  "files": [
    "dist/",
    "bin/",
    "public/",
    "docs/",
    "searxng/",
    "README.md",
    "mcp.json",
    "index.html",
    "vite.config.ts",
    "tsconfig.json"
  ],
  "keywords": [
    "fanluc",
    "ai",
    "agent",
    "terminal",
    "self-host",
    "mcp",
    "chat",
    "monochrome"
  ],
  "author": "mondk",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
