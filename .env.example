# GEMINI_API_KEY: API key for Gemini API calls (optional, only if you use Gemini).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this app is hosted (optional).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SEARXNG_URL: SearXNG instance for search (self-hosted). Default http://localhost:8080
# Requires settings.yml: search.formats: [html, json], server.limiter: false, server.secret_key, image_proxy: true
# Test: curl "http://localhost:8080/search?q=test&format=json"
SEARXNG_URL="http://localhost:8080"

# TOKEN: for MCP remote headers Authorization Bearer ${TOKEN} (read from .env, substituted in mcp.json)
TOKEN="your-mcp-token-here"

# MCP: no extra env needed, mcp.json is loaded at startup

# ADMIN_TOKEN (optional): if set, add/toggle/reconnect MCP require header x-admin-token. Leave empty for personal use.
ADMIN_TOKEN=""

# SANDBOX_VENV (optional): where AI-usable Python libs live. Default /opt/sandbox-venv (Docker) or ./.sandbox-venv
# SANDBOX_UID (Docker sets 10001): OS user AI commands run as when the server is root
# DISABLE_RUN_CMD=1: disable run_cmd + install_pack_v1 entirely
